PROJECT_NAME=ZERVO
API_V1_STR=/api/v1
SECRET_KEY=zervo_super_secret_jwt_key_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Supabase PostgreSQL Database URL
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or default local SQLite fallback for testing: sqlite:///./zervo.db
DATABASE_URL=sqlite:///./zervo.db
SUPABASE_DATABASE_URL=

# Google Gemini API Key (Backend-only, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

